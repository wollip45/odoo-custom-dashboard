<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client Action to launch the OWL Component -->
    <record id="action_custom_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">custom_dashboard.main</field>
    </record>

    <!-- Top Level Menu Item -->
    <menuitem id="menu_custom_dashboard_root"
            name="Dashboard"
            web_icon="custom_dashboard,static/description/icon.png"
            action="action_custom_dashboard"
            sequence="1"/>
</odoo>